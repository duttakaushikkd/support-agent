# OpenAI-compatible provider settings. Leave empty to use deterministic local generation.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Runtime storage
DATABASE_URL=sqlite:///runtime/support_agent.db
# Fixed, deterministic policy threshold. Validate and document its operating point on a local holdout.
AUTO_RESPONSE_THRESHOLD=0.55
RETRIEVAL_THRESHOLD=0.08
