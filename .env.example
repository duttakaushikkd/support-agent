# OpenAI-compatible provider settings. Leave empty to use deterministic local generation.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Runtime storage
DATABASE_URL=sqlite:///runtime/support_agent.db
DATA_DIR=Capstone_Pack/05_Datasets
# Conservative threshold calibrated against development-ticket confidence distribution.
AUTO_RESPONSE_THRESHOLD=0.55
RETRIEVAL_THRESHOLD=0.08
