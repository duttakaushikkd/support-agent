# Choose groq or openrouter. Leave provider keys empty to use local deterministic generation.
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Runtime storage
DATABASE_URL=sqlite:///runtime/support_agent.db
CHROMA_PATH=runtime/chroma
GROUND_TRUTH_PATH=
# Provisional policy floors selected on a stratified 20% development holdout.
AUTO_RESPONSE_THRESHOLD=0.60
AUTO_RESPONSE_URGENCY_THRESHOLD=0.45
RETRIEVAL_THRESHOLD=0.08
CHUNK_SIZE=800
CHUNK_OVERLAP=120
AUTO_RESPONSE_KILL_SWITCH_FILE=runtime/auto_response.disabled
